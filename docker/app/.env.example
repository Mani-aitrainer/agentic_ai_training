# Copy to .env for local runs. NEVER commit the real .env.
# In Docker Compose this file is loaded via `env_file:`.
# Compose reads it via `env_file:`; `docker run --env-file app/.env` does the
# same for a single container. The image never contains these values.

APP_NAME=support-triage-agent
ENVIRONMENT=local
LOG_LEVEL=INFO
PORT=8000

MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.0
REQUEST_TIMEOUT=30
MAX_TOOL_ITERATIONS=4

# Leave blank to run the deterministic stub LLM (container still starts).
OPENAI_API_KEY=

# Leave blank for the in-memory store; set to redis://redis:6379/0 under Compose.
REDIS_URL=
